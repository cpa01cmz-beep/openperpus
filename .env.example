# Salin ke .env.local untuk development lokal. JANGAN commit .env.local.
# .env.local sudah tercakup .gitignore (.env*.local) — jangan commit secret.
# Jangan rotasi secret live dari sini; set nilai asli hanya lokal / via `wrangler secret put`.
# Dapatkan dari: Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiJ9.contoh
# SERVER-ONLY: jangan gunakan di kode klien (tanpa prefix NEXT_PUBLIC).
# Jangan expose ke browser. Untuk Cloudflare, set via `wrangler secret put`.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIn0.contoh-hanya-server

# URL publik situs (tanpa trailing slash). Untuk lokal: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Bearer token melindungi route /api/metrics (scrape Prometheus). Generate acak, mis. `openssl rand -hex 32`.
METRICS_TOKEN=
# Bearer token opsional untuk route /api/readyz (isu #69). Kosong = probe tetap
# publik tanpa auth, cocok untuk health-check load balancer / compose.
READYZ_TOKEN=
# Batas waktu ping Supabase pada /api/readyz dalam milidetik (isu #69).
# Kosong = 3000. Minimum 250. Probe yang melewati batas ini membalas 503.
READYZ_TIMEOUT_MS=
# Tanpa DSN, captureException tetap menulis JSON terstruktur ke log (isu #69) —
# event tidak lagi dibuang seperti sebelumnya.
# Bearer secret melindungi GET /api/cron/sweep-reservations (Vercel Cron harian, isu #76).
# Set nilai yang sama di Vercel Dashboard > Environment Variables. Generate acak, mis. `openssl rand -hex 32`.
CRON_SECRET=
# Batas waktu RPC sweep_expired_reservations pada GET /api/cron/sweep-reservations dalam milidetik (isu #76).
# Kosong = 9000. Minimum 250. Sweep yang melewati batas ini membalas 500 SWEEP_FAILED.
SWEEP_TIMEOUT_MS=
# DSN Sentry untuk error monitoring di src/lib/observability.ts (observability). Kosong = tracking nonaktif.
SENTRY_DSN=

# Kredensial Supabase untuk tes integration (tests/integration — issue #23).
# Kosong = suite integration ter-skip (npm test tetap hijau). Isi dengan proyek
# Supabase khusus tes (BUKAN produksi). Di CI, nilai diambil dari secrets
# TEST_SUPABASE_* saat repo variable RUN_SUPABASE_INTEGRATION=true.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_KEY=

# Storage bucket untuk sampul/gambar: library-assets
# NODE_ENV=development untuk lokal, production saat deploy
